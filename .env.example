# Copy to .env and fill in locally. Never commit secrets.

# --- kill switch (live trading stays off unless BOTH are set) ---
BTC_POLY_LIVE_TRADING=0
# BTC_POLY_LIVE_TRADING_CONFIRM=I_UNDERSTAND

# Optional overrides
# BTC_POLY_CONFIG=config/default.yaml
# BTC_POLY_DATABASE_URL=sqlite:///data/btcpoly.db
# BTC_POLY_LOG_LEVEL=INFO
# BTC_POLY_MARKET_DURATION_MINUTES=15

# Agent Reach / upstream CLIs (Twitter search needs these in the process env)
# TWITTER_AUTH_TOKEN=
# TWITTER_CT0=
# GITHUB_TOKEN=
# EXA_API_KEY=
# REDDIT_PROXY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# BTC_POLY_AI_SENTIMENT=1
